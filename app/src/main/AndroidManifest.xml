<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MapsGLDemo"
        android:resizeableActivity="true"
        android:windowLayoutInDisplayCutoutMode="shortEdges"

        tools:replace="android:theme"
        tools:targetApi="36">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".LegendDataInspectorMenuActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".VectorLayersMenuActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:label="Vector Layers"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".vector.VectorFillMapLayersActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:label="Fill vector layers"
            android:parentActivityName=".VectorLayersMenuActivity" />
        <activity
            android:name=".vector.VectorLineMapLayersActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:label="Line vector layers"
            android:parentActivityName=".VectorLayersMenuActivity" />
        <activity
            android:name=".vector.VectorCircleMapLayersActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:label="Circle vector layers"
            android:parentActivityName=".VectorLayersMenuActivity" />
        <activity
            android:name=".vector.VectorSymbolMapLayersActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:label="Symbol vector layers"
            android:parentActivityName=".VectorLayersMenuActivity" />
        <activity
            android:name=".vector.VectorHeatmapMapLayersActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:label="Heatmap vector layers"
            android:parentActivityName=".VectorLayersMenuActivity" />
        <activity
            android:name=".SampleLayersMenuActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:label="Sample Layers"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".legend.LegendCustomizationActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:label="Legend customization (temperature)"
            android:parentActivityName=".LegendDataInspectorMenuActivity" />
        <activity
            android:name=".legend.LegendAlertsCustomizationActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:label="Legend customization (alerts)"
            android:parentActivityName=".LegendDataInspectorMenuActivity" />
        <activity
            android:name=".legend.LegendsGettingStartedActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:label="Using legends (getting started)"
            android:parentActivityName=".LegendDataInspectorMenuActivity" />
        <activity
            android:name=".legend.DataInspectorGettingStartedActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:label="Data inspector (getting started)"
            android:parentActivityName=".LegendDataInspectorMenuActivity" />
        <activity
            android:name=".legend.CustomLegendsActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:label="Custom legends"
            android:parentActivityName=".LegendDataInspectorMenuActivity" />
        <activity
            android:name=".vector.DataDrivenStylingActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:label="Data-driven styling"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".sample.WeatherDataStylingActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:label="Styling weather data"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".vector.CustomDataSourcesActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:label="Custom data sources"
            android:parentActivityName=".VectorLayersMenuActivity" />
        <activity
            android:name=".sample.AnimatingDataGettingStartedActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:label="Animating data (getting started)"
            android:parentActivityName=".SampleLayersMenuActivity" />
        <activity
            android:name=".maplayers.MapLayersActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".StencilMaskMenuActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".GriddedLayersMenuActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
