            android:name=".stencil.HighwaysConusMaskTemperatureActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:label="Mask customization"
            android:parentActivityName=".StencilMaskMenuActivity" />
        <activity
            android:name=".LocalActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".stencil.Demo2LandMaskTemperatureActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:label="Temperatures (land / water mask)"
            android:parentActivityName=".StencilMaskMenuActivity" />
        <activity
            android:name=".stencil.Demo4PortugalMaskTemperatureActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:label="Portugal: temperature admin mask (invert)"
            android:parentActivityName=".StencilMaskMenuActivity" />
        <activity
            android:name=".stencil.LandHighwayMaskTemperatureActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:label="Temperature (land ∩ highways)"
            android:parentActivityName=".StencilMaskMenuActivity" />
        <activity
            android:name=".stencil.Demo1PortugalSatelliteMaskActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:label="Portugal: satellite geocolor mask"
            android:parentActivityName=".StencilMaskMenuActivity" />
        <activity
            android:name=".BlankMapActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:label="Blank map"
            android:parentActivityName=".MainActivity" />
    </application>

</manifest>