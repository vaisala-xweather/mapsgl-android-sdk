<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher screen, built on the Xweather section-header pattern:
    overline -> headline -> lead, then the navigation list.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xw_bg_primary"
    tools:context=".MainActivity"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:id="@+id/menuHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/xw_margin_screen"
        android:layout_marginTop="@dimen/menu_hero_margin_top"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/menuOverlineTextView"
            style="@style/Xw.SectionOverline"
            android:text="Xweather MapsGL · Android" />

        <TextView
            android:id="@+id/menuTitleTextView"
            style="@style/Xw.Text.H1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MapsGL demo" />

        <TextView
            android:id="@+id/menuLeadTextView"
            style="@style/Xw.SectionLead"
            android:text="Live weather layers, rendered on the device. Every screen below is a working map you can read the source for." />

    </LinearLayout>

    <View
        android:id="@+id/menuHeaderDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginHorizontal="@dimen/xw_margin_screen"
        android:layout_marginTop="@dimen/xw_space_6"
        android:background="@color/xw_border_subtle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/menuHeader" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/menuScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/menu_title_to_list_spacing"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/menuHeaderDivider">

        <LinearLayout
            android:id="@+id/menuButtonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/xw_margin_screen"
            android:orientation="vertical"
            android:paddingBottom="@dimen/menu_list_bottom_padding">

            <Button
                android:id="@+id/menuMapLayersButton"
                style="@style/Xw.MenuRow"
                android:text="All Map Layers" />

            <Button
                android:id="@+id/menuJsParityLayersButton"
                style="@style/Xw.MenuRow"
                android:text="Sorted Map Layers" />

            <Button
                android:id="@+id/menuDocsExamplesButton"
                style="@style/Xw.MenuRow"
                android:text="Documentation Examples" />

            <Button
                android:id="@+id/menuShowcaseButton"
                style="@style/Xw.MenuRow"
                android:text="Showcase" />

            <Button
                android:id="@+id/menuLocalWeatherButton"
                style="@style/Xw.MenuRow"
                android:text="Local Weather" />

            <Button
                android:id="@+id/menuStencilMaskDemosButton"
                style="@style/Xw.MenuRow"
                android:text="Stencil masks" />

            <Button
                android:id="@+id/menuMoreExamplesButton"
                style="@style/Xw.MenuRow"
                android:layout_marginBottom="0dp"
                android:text="More Examples" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
