<?xml version="1.0" encoding="utf-8"?>
<!--
    Extended Tests: the 1.8.0 test notes as screens, grouped by the notes' sections.
    Same shape as activity_more_examples_menu: overline -> headline -> lead, then the list.

    The header block lives inside the scroll view, so it scrolls away with the rows and
    the list gets the full height. Only the back control stays pinned.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xw_bg_primary"
    tools:context=".Qa180MenuActivity"
    tools:ignore="HardcodedText">

    <include
        android:id="@+id/qa180MenuBackToMainButton"
        layout="@layout/widget_back_button"
        android:layout_width="@dimen/back_button_size"
        android:layout_height="@dimen/back_button_size"
        android:layout_marginStart="@dimen/xw_margin_screen"
        android:layout_marginTop="@dimen/menu_header_margin_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/qa180MenuScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/xw_space_4"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/qa180MenuBackToMainButton">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/xw_margin_screen"
            android:orientation="vertical"
            android:paddingBottom="@dimen/menu_list_bottom_padding">

            <TextView
                android:id="@+id/qa180MenuOverlineTextView"
                style="@style/Xw.SectionOverline"
                android:text="MapsGL Android" />

            <TextView
                android:id="@+id/qa180MenuTitleTextView"
                style="@style/Xw.ScreenTitle"
                android:text="Extended Tests" />

            <TextView
                android:id="@+id/qa180MenuLeadTextView"
                style="@style/Xw.SectionLead"
                android:text="One row per step of the 1.8.0 test notes, with what to check." />

            <View
                android:id="@+id/qa180MenuHeaderDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/xw_space_6"
                android:background="@color/xw_border_subtle" />

            <LinearLayout
                android:id="@+id/qa180MenuButtonContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/menu_title_to_list_spacing"
                android:orientation="vertical">

                <!-- Filled in code from Qa180TestsCatalog: an overline per section, a row per step. -->

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
