<?xml version="1.0" encoding="utf-8"?>
<!--
    Showcase menu.
    Xweather section-header pattern: overline -> headline -> lead, then the list.

    The header block lives inside the scroll view, so it scrolls away with the rows and
    the list gets the full height. Only the back control stays pinned.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xw_bg_primary"
    tools:context=".ShowcaseMenuActivity"
    tools:ignore="HardcodedText">

    <include
        android:id="@+id/showcaseMenuBackToMainButton"
        layout="@layout/widget_back_button"
        android:layout_width="@dimen/back_button_size"
        android:layout_height="@dimen/back_button_size"
        android:layout_marginStart="@dimen/xw_margin_screen"
        android:layout_marginTop="@dimen/menu_header_margin_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/showcaseMenuScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/xw_space_4"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/showcaseMenuBackToMainButton">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/xw_margin_screen"
            android:orientation="vertical"
            android:paddingBottom="@dimen/menu_list_bottom_padding">

            <TextView
                android:id="@+id/showcaseMenuOverlineTextView"
                style="@style/Xw.SectionOverline"
                android:text="Guided tour" />

            <TextView
                android:id="@+id/showcaseMenuTitleTextView"
                style="@style/Xw.ScreenTitle"
                android:text="Showcase" />

            <TextView
                android:id="@+id/showcaseMenuIntroTextView"
                style="@style/Xw.SectionLead"
                android:text="A short path through the APIs you would call in an app. Each screen is a live MapsGL map." />

            <View
                android:id="@+id/showcaseMenuHeaderDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/xw_space_6"
                android:background="@color/xw_border_subtle" />

            <LinearLayout
                android:id="@+id/showcaseMenuButtonContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/menu_title_to_list_spacing"
                android:orientation="vertical">

                <include
                    android:id="@+id/showcaseWeatherItem"
                    layout="@layout/widget_showcase_menu_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/main_menu_button_spacing" />

                <include
                    android:id="@+id/showcaseForecastItem"
                    layout="@layout/widget_showcase_menu_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/main_menu_button_spacing" />

                <include
                    android:id="@+id/showcaseLocalItem"
                    layout="@layout/widget_showcase_menu_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/main_menu_button_spacing" />

                <include
                    android:id="@+id/showcaseTropicalItem"
                    layout="@layout/widget_showcase_menu_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/main_menu_button_spacing" />

                <include
                    android:id="@+id/showcaseMaskItem"
                    layout="@layout/widget_showcase_menu_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
