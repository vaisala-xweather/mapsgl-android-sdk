<?xml version="1.0" encoding="utf-8"?>
<!--
    One layer property per screen.
    Xweather section-header pattern: overline -> headline -> lead, then the list.

    The header block lives inside the scroll view, so it scrolls away with the rows and
    the list gets the full height. Only the back control stays pinned.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xw_bg_primary"
    tools:context=".LayerCustomizationMenuActivity"
    tools:ignore="HardcodedText">

    <include
        android:id="@+id/customizationMenuBackToMainButton"
        layout="@layout/widget_back_button"
        android:layout_width="@dimen/back_button_size"
        android:layout_height="@dimen/back_button_size"
        android:layout_marginStart="@dimen/xw_margin_screen"
        android:layout_marginTop="@dimen/menu_header_margin_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/customizationMenuScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/xw_space_4"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/customizationMenuBackToMainButton">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/xw_margin_screen"
            android:orientation="vertical"
            android:paddingBottom="@dimen/menu_list_bottom_padding">

            <TextView
                android:id="@+id/customizationMenuOverlineTextView"
                style="@style/Xw.SectionOverline"
                android:text="Layer API" />

            <TextView
                android:id="@+id/customizationMenuTitleTextView"
                style="@style/Xw.ScreenTitle"
                android:text="Layer customizations" />

            <TextView
                android:id="@+id/customizationMenuLeadTextView"
                style="@style/Xw.SectionLead"
                android:text="Each screen changes one thing about a layer. The source file is the demo." />

            <View
                android:id="@+id/customizationMenuHeaderDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/xw_space_6"
                android:background="@color/xw_border_subtle" />

            <LinearLayout
                android:id="@+id/customizationMenuButtonContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/menu_title_to_list_spacing"
                android:orientation="vertical">

                <Button
                    android:id="@+id/menuDataDrivenColorButton"
                    style="@style/Xw.MenuRow.Tall"
                    android:text="Data-driven colour (interpolate)" />

                <Button
                    android:id="@+id/menuCustomShaderButton"
                    style="@style/Xw.MenuRow.Tall"
                    android:text="Custom GLSL icon shader" />

                <Button
                    android:id="@+id/menuFillSortOrderButton"
                    style="@style/Xw.MenuRow.Tall"
                    android:text="Polygon draw order (sortKey)" />

                <Button
                    android:id="@+id/menuHeatmapTuningButton"
                    style="@style/Xw.MenuRow.Tall"
                    android:text="Heatmap radius, weight and blur" />

                <Button
                    android:id="@+id/menuIconOrientationButton"
                    style="@style/Xw.MenuRow.Tall"
                    android:layout_marginBottom="0dp"
                    android:text="Icons that rotate and pitch with the map" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
