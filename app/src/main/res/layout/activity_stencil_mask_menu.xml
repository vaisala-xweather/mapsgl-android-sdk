<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".StencilMaskMenuActivity">

    <TextView
        android:id="@+id/stencilMenuTitleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/menu_header_margin_top"
        android:text="Stencil masks"
        android:textColor="@color/bright_text"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/stencilMenuScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/stencilMenuTitleTextView">

        <LinearLayout
            android:id="@+id/stencilMenuButtonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <include
                android:id="@+id/stencilMenuBackToMainButton"
                layout="@layout/widget_back_button"
                android:layout_width="@dimen/back_button_size"
                android:layout_height="@dimen/back_button_size"
                android:layout_gravity="start"
                android:layout_marginBottom="@dimen/menu_back_button_spacing_above_first_item" />

            <Button
                android:id="@+id/menuPortugalSatelliteButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/main_menu_button_background_selector"
                android:text="Portugal: satellite geocolor mask"
                android:textAllCaps="false"
                android:textColor="@color/bright_text"
                android:textSize="18sp" />

            <Button
                android:id="@+id/menuDemo2LandMaskTemperatureButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/main_menu_button_background_selector"
                android:text="Temperatures (land / water mask)"
                android:textAllCaps="false"
                android:textColor="@color/bright_text"
                android:textSize="18sp" />

            <Button
                android:id="@+id/menuDemo4PortugalMaskTemperatureButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/main_menu_button_background_selector"
                android:text="Portugal: temperature admin mask (invert)"
                android:textAllCaps="false"
                android:textColor="@color/bright_text"
                android:textSize="18sp" />

            <Button
                android:id="@+id/menuLandHighwayMaskTemperatureButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/main_menu_button_background_selector"
                android:text="Temperature (land ∩ highways)"
                android:textAllCaps="false"
                android:textColor="@color/bright_text"
                android:textSize="18sp" />

            <Button
                android:id="@+id/menuHighwaysConusMaskTemperatureButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/main_menu_button_background_selector"
                android:text="Mask customization"
                android:textAllCaps="false"
                android:textColor="@color/bright_text"
                android:textSize="18sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
