<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/changeMapUnitsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".docExamples.ChangeMapUnitsActivity"
    tools:ignore="ContentDescription">

    <com.mapbox.maps.MapView
        android:id="@+id/changeMapUnitsMapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:mapbox_mapSurface="texture_view" />

    <ImageView
        android:id="@+id/changeMapUnitsBackButton"
        android:layout_width="@dimen/back_button_size"
        android:layout_height="@dimen/back_button_size"
        android:layout_marginStart="@dimen/xw_space_2"
        android:layout_marginTop="@dimen/map_back_button_margin_top"
        android:background="@drawable/circle_background_selector"
        android:contentDescription="Back to documentation examples menu"
        android:padding="@dimen/back_button_padding"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_back_arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Explains what the demo shows, so the screen is readable without the source open. -->
    <TextView
        android:id="@+id/changeMapUnitsCaption"
        style="@style/DemoCaption"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/changeMapUnitsBackButton"
        tools:text="Wind speeds with a legend. The picker changes the speed unit at runtime." />

    <TextView
        android:id="@+id/changeMapUnitsSpeedLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="12dp"
        android:text="Wind speed units"
        style="@style/Xw.Label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/changeMapUnitsCaption" />

    <Spinner
        android:id="@+id/changeMapUnitsSpeedSpinner"
        android:layout_width="140dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/map_overlay_spinner_field_background"
        android:popupBackground="@drawable/map_overlay_spinner_popup_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/changeMapUnitsSpeedLabel" />

</androidx.constraintlayout.widget.ConstraintLayout>
