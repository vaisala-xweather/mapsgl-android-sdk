<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared layout for every layer-customization demo. The demos differ only in the Kotlin that
  styles the layer, so they all reuse this one screen: map, back button, a caption describing
  what you are looking at, and the standard timeline chrome.

  A demo that sets showLegend adds the SDK's legend view into the root at runtime, below the
  caption - the bottom of the screen is taken by the controls panel and the timeline.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/customizationRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".customize.CustomizationDemoActivity"
    tools:ignore="ContentDescription">

    <com.mapbox.maps.MapView
        android:id="@+id/customizationMapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@+id/timeline_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:mapbox_mapSurface="texture_view" />

    <!--
      The back control keeps the circular button used everywhere else in the app; the caption is
      its own panel directly to its right, so the two read as related without being one object.
      Both sit at the top of the window - applyCutoutInsets() adds whatever the display cutout
      needs, so they clear it on any device.
    -->
    <ImageView
        android:id="@+id/customizationBackButton"
        android:layout_width="@dimen/back_button_size"
        android:layout_height="@dimen/back_button_size"
        android:layout_marginStart="@dimen/xw_space_2"
        android:layout_marginTop="@dimen/xw_space_2"
        android:background="@drawable/circle_background_selector"
        android:contentDescription="Back to the layer customization menu"
        android:padding="@dimen/back_button_padding"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_back_arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Explains what the demo changed, so the screen is readable without the source open. -->
    <TextView
        android:id="@+id/customizationCaption"
        style="@style/DemoCaption"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/customizationBackButton"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Fill colour comes from an interpolate expression on the magnitude property." />

    <!-- Controls hang below whichever of the two is taller - a one-line caption is shorter. -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/customizationHeaderBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="customizationBackButton,customizationCaption" />

    <!--
      Controls are built programmatically by each demo (see CustomizationDemoActivity.addSlider /
      addChoice / addToggle), so adding a knob to a demo is one line in its Kotlin rather than
      more XML.
    -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/customizationControlsScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/xw_panel_background"
        android:maxHeight="260dp"
        app:layout_constraintBottom_toTopOf="@+id/timeline_settings_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/customizationControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp" />

    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/timeline_view"
        layout="@layout/timeline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <include
        android:id="@+id/timeline_settings_panel"
        layout="@layout/timeline_settings_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/timeline_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
