<?xml version="1.0" encoding="utf-8"?>
<!--
    Documentation Examples menu.
    Xweather section-header pattern: overline -> headline -> lead, then the list.

    The header block lives inside the scroll view, so it scrolls away with the cards and
    the screenshots get the full height. Only the back control stays pinned.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xw_bg_primary"
    tools:context=".DocsExamplesMenuActivity"
    tools:ignore="HardcodedText">

    <include
        android:id="@+id/docsExamplesMenuBackToMainButton"
        layout="@layout/widget_back_button"
        android:layout_width="@dimen/back_button_size"
        android:layout_height="@dimen/back_button_size"
        android:layout_marginStart="@dimen/xw_margin_screen"
        android:layout_marginTop="@dimen/menu_header_margin_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/docsExamplesMenuScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/xw_space_4"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/docsExamplesMenuBackToMainButton">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/xw_margin_screen"
            android:orientation="vertical"
            android:paddingBottom="@dimen/menu_list_bottom_padding">

            <TextView
                android:id="@+id/docsExamplesMenuOverlineTextView"
                style="@style/Xw.SectionOverline"
                android:text="From the docs" />

            <TextView
                android:id="@+id/docsExamplesMenuTitleTextView"
                style="@style/Xw.ScreenTitle"
                android:text="Documentation examples" />

            <!-- Text set in code: the string carries a link, which needs HtmlCompat. -->
            <TextView
                android:id="@+id/docsExamplesMenuLeadTextView"
                style="@style/Xw.SectionLead"
                android:textColorLink="@color/xw_accent_primary"
                tools:text="The snippets published in the MapsGL guides, running here unmodified." />

            <View
                android:id="@+id/docsExamplesMenuHeaderDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/xw_space_6"
                android:background="@color/xw_border_subtle" />

            <LinearLayout
                android:id="@+id/docsExamplesMenuButtonContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/menu_title_to_list_spacing"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/menuAddGeojsonLayerButton"
                    style="@style/DocsExampleCard">

                    <ImageView
                        style="@style/DocsExampleCardImage"
                        android:contentDescription="A polygon of Portugal filled in red with a thicker red outline"
                        android:src="@drawable/example_add_geojson_layer" />

                    <TextView
                        style="@style/DocsExampleCardTitle"
                        android:text="Adding custom GeoJSON data" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/menuAddRasterLayerButton"
                    style="@style/DocsExampleCard">

                    <ImageView
                        style="@style/DocsExampleCardImage"
                        android:contentDescription="Satellite geocolor imagery over Europe at partial opacity"
                        android:src="@drawable/example_add_raster_layer" />

                    <TextView
                        style="@style/DocsExampleCardTitle"
                        android:text="Adding a custom raster layer" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/menuAddVectorLayerButton"
                    style="@style/DocsExampleCard">

                    <ImageView
                        style="@style/DocsExampleCardImage"
                        android:contentDescription="North Atlantic coastlines outlined in dark grey lines"
                        android:src="@drawable/example_add_vector_layer" />

                    <TextView
                        style="@style/DocsExampleCardTitle"
                        android:text="Adding a custom vector tile layer" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/menuChangeMapUnitsButton"
                    style="@style/DocsExampleCard">

                    <ImageView
                        style="@style/DocsExampleCardImage"
                        android:contentDescription="Wind speeds over the United States with a legend reading in miles per hour"
                        android:src="@drawable/example_change_map_units" />

                    <TextView
                        style="@style/DocsExampleCardTitle"
                        android:text="Change map units" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/menuChangeTimelineRangeButton"
                    style="@style/DocsExampleCard">

                    <ImageView
                        style="@style/DocsExampleCardImage"
                        android:contentDescription="Wind particles over Europe with timeline range controls"
                        android:src="@drawable/example_change_timeline_range" />

                    <TextView
                        style="@style/DocsExampleCardTitle"
                        android:text="Change timeline range" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/menuCustomAlertStylesButton"
                    style="@style/DocsExampleCard">

                    <ImageView
                        style="@style/DocsExampleCardImage"
                        android:contentDescription="Severe weather alert polygons over the United States coloured by severity"
                        android:src="@drawable/example_custom_alert_styles" />

                    <TextView
                        style="@style/DocsExampleCardTitle"
                        android:text="Customizing alert polygon styles" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/menuCustomEarthquakeShaderButton"
                    style="@style/DocsExampleCard">

                    <ImageView
                        style="@style/DocsExampleCardImage"
                        android:contentDescription="Earthquakes across south-east Asia drawn as orange concentric ripples by a custom shader"
                        android:src="@drawable/example_custom_earthquake_shader" />

                    <TextView
                        style="@style/DocsExampleCardTitle"
                        android:text="Custom earthquake symbols using a shader" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/menuCustomFiresShaderButton"
                    style="@style/DocsExampleCard">

                    <ImageView
                        style="@style/DocsExampleCardImage"
                        android:contentDescription="Wildfire observations across the United States drawn as animated orange flames by a custom shader"
                        android:src="@drawable/example_custom_fires_shader" />

                    <TextView
                        style="@style/DocsExampleCardTitle"
                        android:text="Custom fire symbols using a shader" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/menuCustomHeatIndexLegendButton"
                    style="@style/DocsExampleCard">

                    <ImageView
                        style="@style/DocsExampleCardImage"
                        android:contentDescription="A heat index map of the southern United States with a colour bar legend labelled Uncomfortable, Hot and Dangerous"
                        android:src="@drawable/example_custom_heat_index_legend" />

                    <TextView
                        style="@style/DocsExampleCardTitle"
                        android:text="Customizing the heat index legend" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/menuCustomLightningShaderButton"
                    style="@style/DocsExampleCard">

                    <ImageView
                        style="@style/DocsExampleCardImage"
                        android:contentDescription="Lightning strikes over the Atlantic drawn as white flashes by a custom shader on a dark basemap"
                        android:src="@drawable/example_custom_lightning_shader" />

                    <TextView
                        style="@style/DocsExampleCardTitle"
                        android:text="Custom lightning symbols using a shader" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/menuCustomLightningStylesButton"
                    style="@style/DocsExampleCard">

                    <ImageView
                        style="@style/DocsExampleCardImage"
                        android:contentDescription="Lightning strike circles over the Gulf coast, solid white when fresh and fading with age"
                        android:src="@drawable/example_custom_lightning_styles" />

                    <TextView
                        style="@style/DocsExampleCardTitle"
                        android:text="Customizing lightning point styles" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/menuCustomRadarColorscaleButton"
                    style="@style/DocsExampleCard">

                    <ImageView
                        style="@style/DocsExampleCardImage"
                        android:contentDescription="Radar over the central United States drawn in purple and magenta by a custom normalized colour scale"
                        android:src="@drawable/example_custom_radar_colorscale" />

                    <TextView
                        style="@style/DocsExampleCardTitle"
                        android:text="Customizing radar color scale" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/menuCustomTempsFillButton"
                    style="@style/DocsExampleCard">

                    <ImageView
                        style="@style/DocsExampleCardImage"
                        android:contentDescription="Temperatures over the Pacific Northwest drawn in a custom colour ramp, quantized into discrete bands"
                        android:src="@drawable/example_custom_temps_fill" />

                    <TextView
                        style="@style/DocsExampleCardTitle"
                        android:text="Customizing temperature colors" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/menuCustomWindParticlesButton"
                    style="@style/DocsExampleCard">

                    <ImageView
                        style="@style/DocsExampleCardImage"
                        android:contentDescription="Dense wind particles streaming across Europe, coloured from deep blue through magenta to yellow by wind speed"
                        android:src="@drawable/example_custom_wind_particles" />

                    <TextView
                        style="@style/DocsExampleCardTitle"
                        android:text="Customizing wind particles" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/menuFrostFreezeLayerButton"
                    style="@style/DocsExampleCard">

                    <ImageView
                        style="@style/DocsExampleCardImage"
                        android:contentDescription="A frost and freeze map of eastern Canada in three flat colour bands"
                        android:src="@drawable/example_frost_freeze_layer" />

                    <TextView
                        style="@style/DocsExampleCardTitle"
                        android:text="Create a freeze layer" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/menuFilterAlertsButton"
                    style="@style/DocsExampleCard">

                    <ImageView
                        style="@style/DocsExampleCardImage"
                        android:contentDescription="Severe weather alert polygons over the United States, filtered to a single alert category"
                        android:src="@drawable/example_filter_alerts" />

                    <TextView
                        style="@style/DocsExampleCardTitle"
                        android:text="Filter weather alerts by category" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
