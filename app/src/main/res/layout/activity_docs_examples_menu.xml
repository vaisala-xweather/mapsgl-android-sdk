<?xml version="1.0" encoding="utf-8"?>
<!--
    Documentation Examples menu.
    Xweather section-header pattern: overline -> headline -> lead, then the list.

    The header block lives inside the scroll view, so it scrolls away with the cards and
    the screenshots get the full height. Only the back control stays pinned.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xw_bg_primary"
    tools:context=".DocsExamplesMenuActivity"
    tools:ignore="HardcodedText">

    <include
        android:id="@+id/docsExamplesMenuBackToMainButton"
        layout="@layout/widget_back_button"
        android:layout_width="@dimen/back_button_size"
        android:layout_height="@dimen/back_button_size"
        android:layout_marginStart="@dimen/xw_margin_screen"
        android:layout_marginTop="@dimen/menu_header_margin_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/docsExamplesMenuScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/xw_space_4"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/docsExamplesMenuBackToMainButton">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/xw_margin_screen"
            android:orientation="vertical"
            android:paddingBottom="@dimen/menu_list_bottom_padding">

            <TextView
                android:id="@+id/docsExamplesMenuOverlineTextView"
                style="@style/Xw.SectionOverline"
                android:text="From the docs" />

            <TextView
                android:id="@+id/docsExamplesMenuTitleTextView"
                style="@style/Xw.ScreenTitle"
                android:text="Documentation examples" />

            <!-- Text set in code: the string carries a link, which needs HtmlCompat. -->
            <TextView
                android:id="@+id/docsExamplesMenuLeadTextView"
                style="@style/Xw.SectionLead"
                android:textColorLink="@color/xw_accent_primary"
                tools:text="The snippets published in the MapsGL guides, running here unmodified." />

            <View
                android:id="@+id/docsExamplesMenuHeaderDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/xw_space_6"
                android:background="@color/xw_border_subtle" />

            <LinearLayout
                android:id="@+id/docsExamplesMenuButtonContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/menu_title_to_list_spacing"
                android:orientation="vertical">

                <!-- Filled in code from DocsExamplesCatalog: a heading per section, a card per example. -->

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
