<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/timeline_constraint_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="0dp"
    tools:ignore="HardcodedText">


    <LinearLayout
        android:id="@+id/timeline_left_button_column"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="10dp"
        android:gravity="start"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/playControlsCS"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/layer_menu_button"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="@drawable/circle_background_selector"
            android:contentDescription="Layer menu"
            android:elevation="6dp"
            android:outlineProvider="background"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/layer_button_image" />

        <ImageView
            android:id="@+id/mapLayersBackButton"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/circle_background_selector"
            android:contentDescription="Back to main menu"
            android:elevation="6dp"
            android:outlineProvider="background"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back_arrow"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/location_button"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/circle_background_selector"
        android:padding="10dp"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:src="@drawable/location_button_image"
        app:layout_constraintBottom_toBottomOf="@+id/timeline_left_button_column"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/timeline_left_button_column" />

    <!-- Embedded settings (MapLayers and default). Local Weather uses activity-level overlay and sets this include GONE. -->
    <include
        android:id="@+id/settingsCS"
        layout="@layout/timeline_settings_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@id/playControlsCS"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Local Weather: prev/next day + layer checkboxes share one bar; [LocalActivity] sets VISIBLE. Default gone for [MapLayersActivity]. -->
    <LinearLayout
        android:id="@+id/localControlStrip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="0dp"
        android:background="#CC000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="2dp"
        android:paddingVertical="2dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/playControlsCS"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <Button
            android:id="@+id/local_weather_timeline_prev_day_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:backgroundTint="#33FFFFFF"
            android:contentDescription="Previous day"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="◀"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/localLayerTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#E0E0E0"
                    android:checked="true"
                    android:contentDescription="Temperature"
                    android:minHeight="32dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="6dp"
                    android:text="Tmp"
                    android:textColor="@android:color/white"
                    android:textSize="11sp" />

                <CheckBox
                    android:id="@+id/localLayerWind"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#E0E0E0"
                    android:contentDescription="Wind arrows"
                    android:minHeight="32dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="6dp"
                    android:text="Wnd"
                    android:textColor="@android:color/white"
                    android:textSize="11sp" />

                <CheckBox
                    android:id="@+id/localLayerHumidity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#E0E0E0"
                    android:contentDescription="Humidity"
                    android:minHeight="32dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="6dp"
                    android:text="Hm"
                    android:textColor="@android:color/white"
                    android:textSize="11sp" />

                <CheckBox
                    android:id="@+id/localLayerPrecip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#E0E0E0"
                    android:contentDescription="Precipitation"
                    android:minHeight="32dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="6dp"
                    android:text="Pcp"
                    android:textColor="@android:color/white"
                    android:textSize="11sp" />

                <CheckBox
                    android:id="@+id/localLayerRadar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#E0E0E0"
                    android:contentDescription="Radar"
                    android:minHeight="32dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="6dp"
                    android:text="Rdr"
                    android:textColor="@android:color/white"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <Button
            android:id="@+id/local_weather_timeline_next_day_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="2dp"
            android:backgroundTint="#33FFFFFF"
            android:contentDescription="Next day"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="▶"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/playControlsCS"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/grey_background"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/config_button"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/circle_background_selector"
            android:elevation="5dp"
            android:outlineSpotShadowColor="#00000000"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/settings_button_image"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/play_button"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/circle_background_selector"
            android:elevation="0dp"
            android:outlineSpotShadowColor="#00000000"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/play_button_image"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/config_button"
            app:layout_constraintTop_toTopOf="@+id/config_button" />

        <ImageView
            android:id="@+id/play_button_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:elevation="7dp"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/play_button_image"
            app:layout_constraintBottom_toBottomOf="@+id/config_button"
            app:layout_constraintEnd_toEndOf="@+id/play_button"
            app:layout_constraintStart_toStartOf="@+id/play_button"
            app:layout_constraintTop_toTopOf="@+id/play_button" />

        <TextView
            android:id="@+id/currentTimeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:padding="0dp"
            android:textColor="@color/bright_text"
            android:textSize="22sp"
            app:layout_constraintBottom_toTopOf="@id/currentDateTextView"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="Current Time" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:indeterminateTint="@color/white"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/currentDateTextView"
            app:layout_constraintStart_toEndOf="@+id/currentDateTextView"
            app:layout_constraintTop_toTopOf="@+id/currentTimeTextView"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/progressTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@+id/progressBar"
            app:layout_constraintBottom_toBottomOf="@+id/progressBar"
            app:layout_constraintStart_toStartOf="@+id/progressBar"
            app:layout_constraintEnd_toEndOf="@+id/progressBar"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/currentDateTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:padding="0dp"
            android:textColor="@color/dim_text"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="Current Date" />

        <ImageView
            android:id="@+id/interval_back_button"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/button_background_selector"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/prev_button_image"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/currentTimeTextView"
            app:layout_constraintStart_toEndOf="@+id/currentTimeTextView"
            app:layout_constraintTop_toTopOf="@+id/currentTimeTextView" />

        <ImageView
            android:id="@+id/interval_forward_button"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/button_background_selector"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/next_button_image"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/interval_back_button"
            app:layout_constraintStart_toEndOf="@+id/interval_back_button"
            app:layout_constraintTop_toTopOf="@+id/interval_back_button" />


        <com.example.mapsgldemo.helpers.TimelineControls
            android:id="@+id/timeline_controls"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="#00000000"
            android:max="10000"
            android:progressTint="@color/white"
            android:secondaryProgressTint="@color/black"
            android:thumb="@drawable/seekbar_thumb_large"
            android:thumbTint="@color/white"
            app:layout_constraintBottom_toTopOf="@+id/currentTimeTextView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>