<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".AnimatedVectorLayersMenuActivity"
    tools:ignore="HardcodedText">

    <include
        android:id="@+id/animatedVectorMenuBackToMainButton"
        layout="@layout/widget_back_button"
        android:layout_width="@dimen/back_button_size"
        android:layout_height="@dimen/back_button_size"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@id/animatedVectorMenuTitleTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/animatedVectorMenuTitleTextView" />

    <TextView
        android:id="@+id/animatedVectorMenuTitleTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="@dimen/menu_header_margin_top"
        android:layout_marginEnd="16dp"
        android:gravity="start|center_vertical"
        android:text="Animated Vector Layers"
        android:textColor="@color/bright_text"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/animatedVectorMenuBackToMainButton"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/animatedVectorMenuScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/animatedVectorMenuTitleTextView">

        <LinearLayout
            android:id="@+id/animatedVectorMenuButtonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/menuVectorFillButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/main_menu_button_background_selector"
                android:text="Vector fill"
                android:textAllCaps="false"
                android:textColor="@color/bright_text"
                android:textSize="18sp" />

            <Button
                android:id="@+id/menuVectorLineButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/main_menu_button_background_selector"
                android:text="Vector line"
                android:textAllCaps="false"
                android:textColor="@color/bright_text"
                android:textSize="18sp" />

            <Button
                android:id="@+id/menuVectorCircleButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/main_menu_button_background_selector"
                android:text="Vector circle"
                android:textAllCaps="false"
                android:textColor="@color/bright_text"
                android:textSize="18sp" />

            <Button
                android:id="@+id/menuVectorHeatmapButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/main_menu_button_background_selector"
                android:text="Vector heatmap"
                android:textAllCaps="false"
                android:textColor="@color/bright_text"
                android:textSize="18sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
