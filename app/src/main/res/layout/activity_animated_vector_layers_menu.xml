<?xml version="1.0" encoding="utf-8"?>
<!--
    Animated vector layer types.
    Xweather section-header pattern: overline -> headline -> lead, then the list.

    The header block lives inside the scroll view, so it scrolls away with the rows and
    the list gets the full height. Only the back control stays pinned.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xw_bg_primary"
    tools:context=".AnimatedVectorLayersMenuActivity"
    tools:ignore="HardcodedText">

    <include
        android:id="@+id/animatedVectorMenuBackToMainButton"
        layout="@layout/widget_back_button"
        android:layout_width="@dimen/back_button_size"
        android:layout_height="@dimen/back_button_size"
        android:layout_marginStart="@dimen/xw_margin_screen"
        android:layout_marginTop="@dimen/menu_header_margin_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/animatedVectorMenuScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/xw_space_4"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/animatedVectorMenuBackToMainButton">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/xw_margin_screen"
            android:orientation="vertical"
            android:paddingBottom="@dimen/menu_list_bottom_padding">

            <TextView
                android:id="@+id/animatedVectorMenuOverlineTextView"
                style="@style/Xw.SectionOverline"
                android:text="Vector rendering" />

            <TextView
                android:id="@+id/animatedVectorMenuTitleTextView"
                style="@style/Xw.ScreenTitle"
                android:text="Animated vector layers" />

            <TextView
                android:id="@+id/animatedVectorMenuLeadTextView"
                style="@style/Xw.SectionLead"
                android:text="The same animated dataset drawn four ways." />

            <View
                android:id="@+id/animatedVectorMenuHeaderDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/xw_space_6"
                android:background="@color/xw_border_subtle" />

            <LinearLayout
                android:id="@+id/animatedVectorMenuButtonContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/menu_title_to_list_spacing"
                android:orientation="vertical">

                <Button
                    android:id="@+id/menuVectorFillButton"
                    style="@style/Xw.MenuRow.Tall"
                    android:text="Vector fill" />

                <Button
                    android:id="@+id/menuVectorLineButton"
                    style="@style/Xw.MenuRow.Tall"
                    android:text="Vector line" />

                <Button
                    android:id="@+id/menuVectorCircleButton"
                    style="@style/Xw.MenuRow.Tall"
                    android:text="Vector circle" />

                <Button
                    android:id="@+id/menuVectorHeatmapButton"
                    style="@style/Xw.MenuRow.Tall"
                    android:layout_marginBottom="0dp"
                    android:text="Vector heatmap" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
