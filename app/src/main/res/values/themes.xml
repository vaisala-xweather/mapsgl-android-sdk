<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Base application theme.

        The demo is dark-first: full-screen maps on Xweather Black. Framework widget
        colours are wired to brand tokens here so stock controls (checkboxes, seekbars,
        text cursors, spinners) pick up the palette without per-view overrides.
    -->

    <style name="Base.Theme.MapsGLDemo" parent="Theme.AppCompat.DayNight">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowFullscreen">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:textAllCaps">false</item>

        <!-- Brand surfaces -->
        <item name="android:windowBackground">@color/xw_bg_primary</item>
        <item name="android:colorBackground">@color/xw_bg_primary</item>
        <item name="colorPrimary">@color/xw_black_900</item>
        <item name="colorPrimaryDark">@color/xw_black_900</item>

        <!-- Teal marks active state; ember is reserved for CTAs and alerts. -->
        <item name="colorAccent">@color/xw_accent_primary</item>
        <item name="colorControlNormal">@color/xw_text_secondary</item>
        <item name="colorControlActivated">@color/xw_accent_primary</item>
        <item name="colorControlHighlight">@color/xw_surface_overlay</item>

        <!-- Type -->
        <item name="android:textColorPrimary">@color/xw_text_primary</item>
        <item name="android:textColorSecondary">@color/xw_text_secondary</item>
        <item name="android:textColorTertiary">@color/xw_text_tertiary</item>
        <item name="android:textColorHint">@color/xw_text_tertiary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.MapsGLDemo" parent="Base.Theme.MapsGLDemo" />

    <!--
        Small selectable buttons in the blank-map demos. Teal fill when selected,
        so the active demo reads at a glance.
    -->
    <style name="BlankMapDemoButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">@dimen/xw_space_1</item>
        <item name="android:background">@drawable/blank_map_demo_button_background</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingHorizontal">@dimen/xw_space_1</item>
        <item name="android:paddingVertical">@dimen/xw_space_2</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/blank_map_demo_button_text</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Cards on the Documentation Examples menu: a screenshot above the example's title. -->
    <style name="DocsExampleCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/xw_space_3</item>
        <item name="android:background">@drawable/main_menu_button_background_selector</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/xw_space_2</item>
    </style>

    <style name="DocsExampleCardImage">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">110dp</item>
        <item name="android:scaleType">centerCrop</item>
    </style>

    <!-- Card title: H3 at card scale - Light weight, headline tracking. -->
    <style name="DocsExampleCardTitle" parent="Xw.Font.Light">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/xw_space_3</item>
        <item name="android:layout_marginBottom">@dimen/xw_space_1</item>
        <item name="android:layout_marginHorizontal">@dimen/xw_space_2</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:textColor">@color/xw_text_primary</item>
        <item name="android:textSize">@dimen/xw_text_card_title</item>
    </style>

</resources>
