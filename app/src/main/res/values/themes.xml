<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->

    <style name="Base.Theme.MapsGLDemo" parent="Theme.AppCompat.DayNight">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowFullscreen">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Theme.MapsGLDemo" parent="Base.Theme.MapsGLDemo" >

        <!--item name="android:windowTranslucentStatus">true</item-->




    </style>

    <style name="BlankMapDemoButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:background">@drawable/blank_map_demo_button_background</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">45dp</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/blank_map_demo_button_text</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Cards on the Documentation Examples menu: a screenshot above the example's title. -->
    <style name="DocsExampleCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:background">@drawable/main_menu_button_background_selector</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="DocsExampleCardImage">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">110dp</item>
        <item name="android:scaleType">centerCrop</item>
    </style>

    <style name="DocsExampleCardTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:textColor">@color/bright_text</item>
        <item name="android:textSize">18sp</item>
    </style>

</resources>
