<?xml version="1.0" encoding="utf-8"?>
<!-- Input: focus is signalled by the teal accent border. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/xw_bg_primary" />
            <corners android:radius="@dimen/xw_radius_sm" />
            <stroke android:width="@dimen/xw_border_width" android:color="@color/xw_accent_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/xw_bg_primary" />
            <corners android:radius="@dimen/xw_radius_sm" />
            <stroke android:width="@dimen/xw_border_width" android:color="@color/xw_border" />
        </shape>
    </item>
</selector>
